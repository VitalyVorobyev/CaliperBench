{
  "$defs": {
    "EdgeTruth": {
      "additionalProperties": false,
      "properties": {
        "positions_px": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "title": "Positions Px",
          "type": "array"
        },
        "uncertainty_px": {
          "minimum": 0,
          "title": "Uncertainty Px",
          "type": "number"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "phases": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phases"
        }
      },
      "required": [
        "positions_px",
        "uncertainty_px",
        "method",
        "confidence"
      ],
      "title": "EdgeTruth",
      "type": "object"
    },
    "PhysicalTruth": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "enum": [
            "mm",
            "um",
            "m"
          ],
          "title": "Unit",
          "type": "string"
        },
        "uncertainty": {
          "minimum": 0,
          "title": "Uncertainty",
          "type": "number"
        },
        "quantity": {
          "minLength": 1,
          "title": "Quantity",
          "type": "string"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "calibration_ref": {
          "minLength": 1,
          "title": "Calibration Ref",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit",
        "uncertainty",
        "quantity",
        "method",
        "calibration_ref"
      ],
      "title": "PhysicalTruth",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "source_version": {
          "title": "Source Version",
          "type": "string"
        },
        "license": {
          "title": "License",
          "type": "string"
        },
        "source_image_id": {
          "title": "Source Image Id",
          "type": "string"
        },
        "annotator": {
          "title": "Annotator",
          "type": "string"
        },
        "annotation_version": {
          "title": "Annotation Version",
          "type": "string"
        },
        "derivation": {
          "title": "Derivation",
          "type": "string"
        },
        "group_id": {
          "title": "Group Id",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "source_url",
        "source_version",
        "license",
        "source_image_id",
        "annotator",
        "annotation_version",
        "derivation",
        "group_id"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Request": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sample_id": {
          "minLength": 1,
          "title": "Sample Id",
          "type": "string"
        },
        "image": {
          "title": "Image",
          "type": "string"
        },
        "image_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Image Sha256",
          "type": "string"
        },
        "strip": {
          "$ref": "#/$defs/Strip"
        },
        "polarities": {
          "items": {
            "enum": [
              "rising",
              "falling",
              "either"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Polarities",
          "type": "array"
        }
      },
      "required": [
        "sample_id",
        "image",
        "image_sha256",
        "strip",
        "polarities"
      ],
      "title": "Request",
      "type": "object"
    },
    "Strip": {
      "additionalProperties": false,
      "properties": {
        "start_xy": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start Xy",
          "type": "array"
        },
        "end_xy": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "End Xy",
          "type": "array"
        },
        "width_px": {
          "default": 1,
          "minimum": 1,
          "title": "Width Px",
          "type": "number"
        },
        "samples": {
          "default": 101,
          "maximum": 100000,
          "minimum": 5,
          "title": "Samples",
          "type": "integer"
        },
        "across": {
          "default": 1,
          "maximum": 1000,
          "minimum": 1,
          "title": "Across",
          "type": "integer"
        }
      },
      "required": [
        "start_xy",
        "end_xy"
      ],
      "title": "Strip",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request": {
      "$ref": "#/$defs/Request"
    },
    "split": {
      "enum": [
        "development",
        "validation",
        "test"
      ],
      "title": "Split",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "edge_truth": {
      "anyOf": [
        {
          "$ref": "#/$defs/EdgeTruth"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "physical_truth": {
      "anyOf": [
        {
          "$ref": "#/$defs/PhysicalTruth"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "request",
    "split",
    "provenance"
  ],
  "title": "Sample",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
